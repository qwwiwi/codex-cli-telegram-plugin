# Copy to .env and fill in the values. See docs/quickstart.md for a filled example.
# Use your own bot token and your own numeric Telegram IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_EXPECTED_BOT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# Absolute paths. Keep the state directory outside the workspace.
TELEGRAM_STATE_DIR=
TELEGRAM_WORKSPACE_ROOT=
# Имя личного агента для статуса, приветствий и экспорта.
# KROT_CODEX_AGENT_NAME=Мой агент
# KROT_CODEX_AGENT_ID=krotov
# KROT_CODEX_APPROVALS=1
# Режим карточек standard (по умолчанию) или risky. Для risky нужны включённые карточки.
# KROT_CODEX_APPROVAL_MODE=risky
# GROQ_API_KEY=
# KROT_CODEX_LEARNING=1
# KROT_CODEX_LEARNING_INTERVAL=10
# KROT_CODEX_LEARNING_AUTO_SAVE=0
# KROT_CODEX_LEARNING_MODEL=
# KROT_CODEX_SIDE_REPLY=1
# Под управлением systemd разрешает явно запрошенный владельцем перезапуск моста после доставки итога.
# KROT_CODEX_SELF_RESTART=1
# KROT_CODEX_COMMANDS_DIR=
